# Settings for docker-compose.yml. Copy to .env and fill in. Never commit .env.

# Database password (any long random string)
DB_PASSWORD=

# Signs login tokens. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The public https address people use, no trailing slash. Used for CORS and for links in emails.
APP_ORIGIN=https://app.example.com
# Other browser origins allowed to call the API (comma separated), e.g. the marketing site
CORS_ORIGINS=

# Platform operator account (optional; leave blank to create none)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Outbound email. Blank = emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FlowXP <no-reply@example.com>

# Flow AI and reading menus from photos. Blank = those features stay off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Customer messages: log (send nothing) | whatsapp_cloud | twilio. See DEPLOY.md.
MESSAGING_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Uploaded photos: "local" keeps them on the server's disk volume; "s3" uses a bucket
# (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO), which survives moving servers.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address photos are read from (a CDN or the bucket's public URL)
S3_PUBLIC_URL=

# Port the web container listens on
WEB_PORT=80
