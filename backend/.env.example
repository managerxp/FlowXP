# FlowXP backend configuration.
# Copy to .env and fill in. Nothing here has a usable default in production —
# the server refuses to start without DATABASE_URL and JWT_SECRET.

PORT=5100
NODE_ENV=development

# Postgres. FlowXP owns its own database — it shares nothing with ManagerXP.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowxp

# Sign JWTs with this. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional but recommended: a second secret (32+ characters) that protects stored 2FA secrets and payment/messaging keys, so changing JWT_SECRET (to sign everyone out)
# does not lock 2FA users out. After setting it, run: node scripts/reencrypt-secrets.mjs
ENCRYPTION_KEY=
# Phone notifications (Expo push). On by default; set false to switch off. EXPO_ACCESS_TOKEN only if the Expo project has push security enabled.
# PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=
JWT_EXPIRES_IN=7d

# Where the browser app lives, for CORS and for links inside emails.
APP_ORIGIN=http://localhost:5173
# Other browser origins allowed to call the API (comma separated), e.g. a separate marketing site. Optional.
CORS_ORIGINS=

# Length of the free trial, in days. Configurable rather than hardcoded so
# marketing can run a 14-day promotion without a deploy.
TRIAL_DAYS=7

# Sign in with Google, for accounts that already exist (never for sign-up). Leave both blank to hide the button.
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Authorised redirect URI, exactly: https://flowxp.in/api/auth/google/callback (APP_ORIGIN + /api/auth/google/callback)
# For local development add http://localhost:5174/api/auth/google/callback and set GOOGLE_REDIRECT_URI to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# The platform operator account — /superadmin on the frontend, /api/admin on
# this API. Seeded (or re-flagged if the row already exists) at every boot;
# see config/seedSuperAdmin.js. Leave blank to skip seeding one entirely.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Outbound email (password resets). Leave SMTP_HOST empty in development —
# the mailer then logs the message instead of sending it. Overridable without
# a restart from Super Admin -> Settings -> Email; these are just the fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FlowXP <flowxp.manager@gmail.com>"

# Flow AI (the assistant chat, onboarding helper, menu-photo scan and review-reply drafts — all one
# provider, picked here). Leave the active provider's key blank to keep the feature off: the app then
# says it isn't set up and nothing is sent to any provider. Only summarised business figures are sent,
# never customer phone numbers.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# To use Google Gemini instead: set AI_PROVIDER=gemini and fill these in.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Three tiers, one per task's actual need — see modules/ai/provider.js's modelFor() and each feature
# module's own complete() call for which tier it asks for and why. Any left blank falls back to the
# others, in order, so setting just GEMINI_DEFAULT_MODEL alone still works.
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.8-flash
AI_MAX_TOKENS=1200

# Customer messages (bill by WhatsApp/SMS, booking confirmations, offers).
# log = send nothing, only record; whatsapp_cloud = Meta WhatsApp Cloud API; twilio = SMS via Twilio.
# Overridable without a restart from Super Admin -> Settings -> Messaging; these are just the fallback.
MESSAGING_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_LANG=en
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
MESSAGING_COUNTRY_CODE=91

# Cashfree Payment Links (custom-priced subscriptions — the admin sets a price
# per business and sends a hosted checkout link, there is no fixed self-serve
# price). Leave blank to keep the feature off: link creation then fails with a
# clear message instead of a broken call. SANDBOX for testing, PRODUCTION to
# actually collect money. Set the webhook URL in the Cashfree dashboard to
# APP_ORIGIN + /api/webhooks/cashfree.
# Overridable without a restart from Super Admin -> Settings -> Payment gateway; these are just the fallback.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# Uploaded photos. local = this server's own disk, under /uploads — fine on one VPS that you back up.
# s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO); required if you ever
# move servers or run more than one API instance, since local disk isn't shared between them.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
